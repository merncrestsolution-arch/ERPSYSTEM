# Supabase configuration used by the web/mobile (Capacitor) build.
# Copy this file to `.env` and fill in your project's values.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Cloudflare Turnstile (web login — invisible / background). Optional; a production default is used if empty.
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEA-_ZRG0NySV866
